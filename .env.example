# Flight Service Configuration
# Copy this file to .env and fill in your actual values

# Server
PORT=3003
NODE_ENV=development

# Anthropic API Key (required for Claude briefing synthesis)
# Get your key from https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-v7-YOUR_KEY_HERE

# Optional: Third-party integrations (future)
# FAA_NOTAM_API_KEY=...
# OPENWEATHER_API_KEY=...
